# Copy to .env and fill in. .env is gitignored.
#
# Bot token from https://discord.com/developers/applications -> your app -> Bot.
# The provider reads this directly; never put it in a .tf or .tfvars file.
DISCORD_TOKEN=

# HCP Terraform (state backend). The `cloud {}` block in each environment is
# intentionally empty so the organization and workspace stay out of the repo.
TF_CLOUD_ORGANIZATION=
TF_WORKSPACE=discord-staging
